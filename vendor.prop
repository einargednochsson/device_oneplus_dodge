# ALS
vendor.sensors.als_correction.grabrect=997 132 1062 209
vendor.sensors.als_correction.bias=0
vendor.sensors.als_correction.grayscale_weights=0.25 0.57 0.18
vendor.sensors.als_correction.sensor_inverse_gain=1.0 1.0 1.0 1.0
vendor.sensors.als_correction.brightness_breakpoint=3500.0
vendor.sensors.als_correction.brightness_poly0=0.00004279 0.0097813 4.8116
vendor.sensors.als_correction.brightness_poly1=0.0 0.9493 -2785.597

# Bluetooth
bluetooth.device.default_name=OnePlus 13

# USB
vendor.usb.product_string=OnePlus 13

# Enable or disable ScrollOptimizer globally
persist.sys.perf.scroll_opt = true

# Heavy app handling mode
# 0 - Disable heavy app classification
# 1 - Enable dynamic detection (based on frame duration and buffer load)
# 2 - Treat all apps as heavy for performance
persist.sys.perf.scroll_opt.heavy_app = 2
